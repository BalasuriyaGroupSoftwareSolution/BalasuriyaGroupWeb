# Copy to ".env" in this folder for local development. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables instead.

# --- Database (required) ---------------------------------------------------
# Neon (free) creates both automatically when you connect it to Vercel.
# Locally, point both at the same Postgres (e.g. `docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balasuriya_group
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/balasuriya_group

# --- Sessions (required in production) -------------------------------------
# A long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- First owner login (used once, on a brand-new database) -----------------
SEED_OWNER_EMAIL=clemonbalasuriyagroup@gmail.com
SEED_OWNER_PASSWORD=

# --- Email via Resend (free 3,000/month) — needed for password reset & codes -
RESEND_API_KEY=
FROM_EMAIL=Balasuriya Group <security@balasuriyagroup.tech>
NOTIFY_EMAIL=balasuriyagroup.info@gmail.com

# --- Site ------------------------------------------------------------------
SITE_URL=https://www.balasuriyagroup.tech
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional: Google sign-in (both must match) -----------------------------
GOOGLE_CLIENT_ID=
