{
  "name": "balasuriya-group-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate --schema backend/prisma/schema.prisma",
    "build:backend": "prisma generate --schema backend/prisma/schema.prisma && tsc -p backend/tsconfig.json",
    "build:frontend": "npm --prefix frontend ci --include=dev && npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/dist/scripts/seed.js",
    "vercel-build": "npm run build:backend && npm run db:migrate && npm run db:seed && npm run build:frontend",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "npm --prefix frontend run dev",
    "test:security": "npm run build:backend && node -e \"require('fs').copyFileSync('backend/test/fake-prisma.js','backend/dist/lib/prisma.js')\" && node backend/test/security-smoke.mjs && npm run build:backend"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "prisma": "5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
