# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balasuriya_group

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=https://balasuriyagroup.tech,https://www.balasuriyagroup.tech,http://localhost:5173

# OAuth Client ID from Google Cloud Console (Web application credentials).
# Required for Google sign-in; without it, /api/auth/google is refused.
GOOGLE_CLIENT_ID=

# Optional seed defaults (see prisma/seed.ts)
SEED_OWNER_EMAIL=owner@balasuriyagroup.tech
SEED_OWNER_PASSWORD=
