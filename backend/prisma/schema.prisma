// Balasuriya Group — database schema
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  CONSTRUCTION_MANAGER
  TOURISM_AGENT
  FINANCE_APPROVER
  TICKET_AGENT
  SOFTWARE_ENGINEER
  CHARTERED_ACCOUNTANT
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  constructionProjects ConstructionProject[] @relation("ProjectCreatedBy")
  progressUpdates      ProgressUpdate[]
  tourPackages         TourPackage[]          @relation("PackageCreatedBy")
  promotions           Promotion[]
  bookings             Booking[]
  approvedPayments     Payment[]              @relation("PaymentApprovedBy")

  @@index([role])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model ConstructionProject {
  id            String        @id @default(cuid())
  name          String
  description   String?
  location      String?
  status        ProjectStatus @default(PLANNING)
  // Free-text category for display (e.g. "Residential", "Commercial",
  // "Infrastructure", "Industrial", "Renovation"). Not an enum since staff
  // may want new categories later without a migration.
  projectType   String?
  // Cover photo shown on the public listing, chosen by staff for this
  // project. Same convention as ProgressUpdate.photoUrls — an externally
  // hosted image URL (no file upload storage yet).
  coverImageUrl String?
  // Staff pick which projects appear in the public "Selected Projects"
  // showcase, instead of every project always being shown.
  featured      Boolean       @default(false)
  startDate     DateTime?
  targetEndDate DateTime?
  createdById   String
  createdBy     User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  progressUpdates ProgressUpdate[]

  @@index([featured])
}

model ProgressUpdate {
  id              String              @id @default(cuid())
  projectId       String
  project         ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                @relation(fields: [authorId], references: [id])
  currentStatus   String
  nextPeriodPlan  String
  percentComplete Int                 @default(0)
  photoUrls       String[]            @default([])
  createdAt       DateTime            @default(now())

  @@index([projectId])
}

enum TourCategory {
  LOCAL
  FOREIGN
  FAMILY
  TEAM
  RELIGIOUS
}

model TourPackage {
  id             String       @id @default(cuid())
  title          String
  description    String
  category       TourCategory
  priceLkr       Decimal      @db.Decimal(12, 2)
  durationDays   Int
  availableSlots Int          @default(0)
  isActive       Boolean      @default(true)
  createdById    String
  createdBy      User         @relation("PackageCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  promotions Promotion[]
  bookings   Booking[]

  @@index([category])
}

model Promotion {
  id              String       @id @default(cuid())
  packageId       String?
  package         TourPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  discountPercent Int
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean      @default(true)
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())

  @@index([packageId])
}

enum BookingType {
  TOUR_PACKAGE
  AIR_TICKET
  VISA_ASSISTANCE
  CONSTRUCTION_QUOTE
  SOFTWARE_PROJECT
  GENERAL_INQUIRY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  type        BookingType
  packageId   String?
  package     TourPackage?  @relation(fields: [packageId], references: [id])
  details     Json?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
}

enum PaymentMethod {
  CARD
  GOOGLE_PAY
  BANK_DEPOSIT
  KOKO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amountLkr      Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  // Bank deposit slip reference, gateway transaction id, etc.
  reference      String?
  notes          String?
  approvedById   String?
  approvedBy     User?         @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([bookingId])
  @@index([status])
}

// One-time codes for OTP login/verification (email or phone)
model VerificationCode {
  id         String   @id @default(cuid())
  identifier String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
}
