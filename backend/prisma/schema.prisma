// Balasuriya Group — database schema
// Run `npm run prisma:migrate` after setting DATABASE_URL in .env

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev, rhel-openssl-3.0.x for Vercel serverless functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// DATABASE_URL          = pooled connection (used by the running site)
// DATABASE_URL_UNPOOLED = direct connection (used only by `prisma migrate deploy`)
// The Neon <-> Vercel integration creates both variables automatically.
// For local dev, set both to the same local Postgres URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  CONSTRUCTION_MANAGER
  TOURISM_AGENT
  FINANCE_APPROVER
  TICKET_AGENT
  SOFTWARE_ENGINEER
  CHARTERED_ACCOUNTANT
  CONSTRUCTION_STAFF
  TOURISM_STAFF
  SOFTWARE_STAFF
  TICKET_STAFF
  FINANCE_STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  name         String
  role         Role     @default(CUSTOMER)
  // Extra roles held alongside the primary one (e.g. ADMIN who is also TOURISM_AGENT)
  secondaryRoles    Role[]   @default([])
  department        String?
  jobTitle          String?
  assignedDivisions String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  constructionProjects ConstructionProject[] @relation("ProjectCreatedBy")
  progressUpdates      ProgressUpdate[]
  tourPackages         TourPackage[]          @relation("PackageCreatedBy")
  promotions           Promotion[]
  bookings             Booking[]
  approvedPayments     Payment[]              @relation("PaymentApprovedBy")

  @@index([role])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

model ConstructionProject {
  id            String        @id @default(cuid())
  name          String
  description   String?
  location      String?
  status        ProjectStatus @default(PLANNING)
  // Free-text category for display (e.g. "Residential", "Commercial",
  // "Infrastructure", "Industrial", "Renovation"). Not an enum since staff
  // may want new categories later without a migration.
  projectType   String?
  // Cover photo shown on the public listing, chosen by staff for this
  // project. Same convention as ProgressUpdate.photoUrls — an externally
  // hosted image URL (no file upload storage yet).
  coverImageUrl String?
  // Staff pick which projects appear in the public "Selected Projects"
  // showcase, instead of every project always being shown.
  featured      Boolean       @default(false)
  startDate     DateTime?
  targetEndDate DateTime?
  createdById   String
  createdBy     User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  progressUpdates ProgressUpdate[]

  @@index([featured])
}

model ProgressUpdate {
  id              String              @id @default(cuid())
  projectId       String
  project         ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId        String
  author          User                @relation(fields: [authorId], references: [id])
  currentStatus   String
  nextPeriodPlan  String
  percentComplete Int                 @default(0)
  photoUrls       String[]            @default([])
  createdAt       DateTime            @default(now())

  @@index([projectId])
}

enum TourCategory {
  LOCAL
  FOREIGN
  FAMILY
  TEAM
  RELIGIOUS
}

model TourPackage {
  id             String       @id @default(cuid())
  title          String
  description    String
  category       TourCategory
  priceLkr       Decimal      @db.Decimal(12, 2)
  durationDays   Int
  availableSlots Int          @default(0)
  isActive       Boolean      @default(true)
  createdById    String
  createdBy      User         @relation("PackageCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  promotions Promotion[]
  bookings   Booking[]

  @@index([category])
}

model Promotion {
  id              String       @id @default(cuid())
  packageId       String?
  package         TourPackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  discountPercent Int
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean      @default(true)
  createdById     String
  createdBy       User         @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())

  @@index([packageId])
}

enum BookingType {
  TOUR_PACKAGE
  AIR_TICKET
  VISA_ASSISTANCE
  CONSTRUCTION_QUOTE
  SOFTWARE_PROJECT
  GENERAL_INQUIRY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  type        BookingType
  packageId   String?
  package     TourPackage?  @relation(fields: [packageId], references: [id])
  details     Json?
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments Payment[]

  @@index([customerId])
  @@index([status])
}

enum PaymentMethod {
  CARD
  GOOGLE_PAY
  BANK_DEPOSIT
  KOKO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  amountLkr      Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  // Bank deposit slip reference, gateway transaction id, etc.
  reference      String?
  notes          String?
  approvedById   String?
  approvedBy     User?         @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([bookingId])
  @@index([status])
}

// One-time codes for OTP login/verification (email or phone)
model VerificationCode {
  id         String   @id @default(cuid())
  identifier String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

enum VisaStatus {
  SUBMITTED
  UNDER_REVIEW
  DOCS_REQUIRED
  EMBASSY_PROCESSING
  APPROVED
  REJECTED
}

// Online visa applications. Contains passport data, so it is only ever
// readable by the applicant who owns it and by tourism/ticketing staff.
model VisaApplication {
  id                    String     @id @default(cuid())
  referenceNo           String     @unique
  userId                String?
  userEmail             String
  userName              String
  phone                 String
  country               String
  countryFlag           String?
  category              String
  visaTypeLabel         String?
  entryType             String     @default("SINGLE")
  passportNumber        String
  passportExpiry        String?
  passportIssueDate     String?
  nationality           String?
  dateOfBirth           String?
  gender                String?
  occupation            String?
  employerName          String?
  intendedArrivalDate   String?
  intendedDepartureDate String?
  stayDurationDays      Int?
  destinationAddress    String?
  sponsorCompany        String?
  sponsorContact        String?
  meetingPurpose        String?
  notes                 String?
  documentSummary       String?
  status                VisaStatus @default(SUBMITTED)
  statusNotes           String?
  submittedAt           DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userEmail])
  @@index([status])
}
