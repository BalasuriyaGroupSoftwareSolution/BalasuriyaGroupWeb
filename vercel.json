{
  "buildCommand": "npm run build:all",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/users/(.*)",
      "destination": "/api/users/index.js"
    },
    {
      "source": "/api/users",
      "destination": "/api/users/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
